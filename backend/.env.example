# Database configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/geoportail

# Server configuration
PORT=4000

# CORS (optional - defaults to allowing all origins)
# CORS_ORIGIN=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com,https://your-parent-site.com
# If your iframe is sandboxed and sends Origin: null, allow it explicitly:
# CORS_ALLOW_NULL_ORIGIN=true
